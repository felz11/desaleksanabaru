# Salin variabel ini ke Vercel Dashboard → Project Settings → Environment Variables
# JANGAN commit file .env asli (isi sebenarnya) ke GitHub.

# Password untuk login ke halaman /admin.html — bebas, buat sendiri yang kuat
ADMIN_PASSWORD=

# Personal Access Token GitHub (Settings → Developer settings → Personal access tokens)
# Minimal scope: "repo" (untuk commit ke repository)
GITHUB_TOKEN=

# Format: username/nama-repo
GITHUB_REPO=

# Branch yang dipakai Vercel untuk auto-deploy (biasanya "main")
GITHUB_BRANCH=main
